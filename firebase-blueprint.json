{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and device settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "vibrationIntensity": { "type": "number" },
            "breathingPattern": { "type": "string" },
            "aiSensitivity": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Session": {
      "title": "Biometric Session",
      "description": "Metadata for a regulation or monitoring session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["monitoring", "breathing", "training", "panic"] },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "avgHeartRate": { "type": "number" },
        "avgHRV": { "type": "number" },
        "recoveryScore": { "type": "number" },
        "stabilityScore": { "type": "number" }
      }
    },
    "BiometricSample": {
      "title": "Biometric Sample",
      "description": "A single data point captured during a session.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "heartRate": { "type": "number" },
        "hrv": { "type": "number" },
        "breathingRate": { "type": "number" },
        "stressIndex": { "type": "number" }
      }
    },
    "StressEvent": {
      "title": "Stress Event",
      "description": "A detected significant physiological stress event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "intensity": { "type": "number" },
        "context": { "type": "string" },
        "triggerType": { "type": "string" }
      }
    },
    "Insight": {
      "title": "AI Insight",
      "description": "Personalized physiological intelligence generated by AI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "dataCorrelation": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user document."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "User's biometric sessions."
    },
    "/users/{userId}/sessions/{sessionId}/samples/{sampleId}": {
      "schema": "BiometricSample",
      "description": "Granular data points for a session."
    },
    "/users/{userId}/stressEvents/{eventId}": {
      "schema": "StressEvent",
      "description": "Detected periods of high stress."
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": "Insight",
      "description": "Personalized AI-driven physiological insights."
    }
  }
}
